<!DOCTYPE html>
<html>
  <head>
    <title>RailsPokemon</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <style>
      body { font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif; margin: 24px; }
      nav { display:flex; gap:12px; margin-bottom:16px; }
      .button { display:inline-block; padding:8px 12px; border-radius:8px; border:1px solid #ddd; text-decoration:none; }
      .grid { display:grid; grid-template-columns: repeat(auto-fill, minmax(220px,1fr)); gap:16px; }
      .card { padding:12px; border:1px solid #eee; border-radius:12px; box-shadow:0 1px 2px rgba(0,0,0,0.05); background:#fff; }
      .profile { display:flex; align-items:center; gap:16px; }
      .field { margin:8px 0; }
      .actions { margin-top:12px; }
      .flash { padding:10px 12px; border-radius:8px; margin-bottom:12px; }
      .flash.notice { background:#e8f5e9; border:1px solid #c8e6c9; }
      .flash.alert  { background:#ffebee; border:1px solid #ffcdd2; }
    </style>
  </head>
  <body>
    <nav>
      <%= link_to "🏠 Pokedex", root_path, class: "button" %>
      <%= link_to "🧑‍🎓 Trainers", trainers_path, class: "button" %>
      <%= link_to "🎲 Random", random_pokemons_path, class: "button" %>
    </nav>

    <% if notice %><div class="flash notice"><%= notice %></div><% end %>
    <% if alert  %><div class="flash alert"><%= alert  %></div><% end %>

    <%= yield %>
  </body>
</html>
