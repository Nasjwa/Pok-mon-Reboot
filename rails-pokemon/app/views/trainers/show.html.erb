<!-- app/views/trainers/show.html.erb -->
<%= link_to "← Back to Trainers", trainers_path %>

<div class="profile">
  <% if @trainer.photo.attached? %>
    <%= cl_image_tag @trainer.photo.key, alt: @trainer.name, width: 260, height: 260, crop: :fill %>
  <% end %>
  <div>
    <h1><%= @trainer.name %></h1>
    <p>Age: <%= @trainer.age %></p>
  </div>
</div>

<hr>

<h2><%= @trainer.name %>’s Pokémon</h2>

<% if @trainer.pokemons.any? %>
  <div class="grid">
    <% @trainer.pokemons.each do |pokemon| %>
      <% pokeball = @trainer.pokeballs.find { |pb| pb.pokemon_id == pokemon.id } %>
      <div class="card">
        <% if pokemon.photo.attached? %>
          <%= cl_image_tag pokemon.photo.key, alt: pokemon.name, width: 160, height: 160, crop: :fill %>
        <% end %>
        <h3><%= link_to pokemon.name, pokemon_path(pokemon) %></h3>
        <p>Type: <%= pokemon.element_type.capitalize %></p>
        <% if pokeball %>
          <p>Caught on <%= pokeball.caught_on.strftime("%b %d, %Y") %> in <%= pokeball.location %></p>
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <p>No Pokémon yet. Go catch some!</p>
<% end %>
